{
  "schema_version": 1,
  "catalog_id": "planning-toolbox-sketchup-component-library",
  "version": "2026.08.10",
  "updated_at": "2026-08-10",
  "name": "Planning Toolbox 轻量 SketchUp 组件库",
  "purpose": "为城乡规划 CAD→SU 模型提供可复用、可追溯、按需加载的真实组件",
  "runtime_policy": {
    "load_mode": "lazy_shared_component_definition",
    "network_required": false,
    "api_required": false,
    "allow_licenses": [
      "CC0-1.0"
    ],
    "component_file_budget_bytes": 8000000,
    "bundled_component_budget_bytes": 100000000,
    "bundled_component_total_bytes": 1220468,
    "fallback": "procedural_native_geometry",
    "user_components_take_priority": true,
    "description": "只在实际需要相应对象时加载 SKP 定义，同类对象共享定义，不复制整套几何。"
  },
  "sources": [
    {
      "id": "kenney-city-kit-roads-2.0",
      "title": "Kenney City Kit (Roads) 2.0",
      "url": "https://www.kenney.nl/assets/city-kit-roads",
      "download_url": "https://www.kenney.nl/media/pages/assets/city-kit-roads/74288c9459-1741864740/kenney_city-kit-roads.zip",
      "license": "CC0-1.0",
      "creator": "Kenney",
      "bundled_selection": [
        "light-curved.glb"
      ],
      "reason": "低多边形道路与街道设施，尺寸小，适合规划模型重复布置。"
    },
    {
      "id": "kenney-city-kit-suburban-2.0",
      "title": "Kenney City Kit (Suburban) 2.0",
      "url": "https://kenney.nl/assets/city-kit-suburban",
      "download_url": "https://kenney.nl/media/pages/assets/city-kit-suburban/2c871b7af2-1745479373/kenney_city-kit-suburban_20.zip",
      "license": "CC0-1.0",
      "creator": "Kenney",
      "bundled_selection": [
        "tree-large.glb",
        "tree-small.glb",
        "planter.glb"
      ],
      "reason": "风格一致的低多边形树木与花池，可替换过于示意的程序化圆冠树。"
    },
    {
      "id": "kenney-city-kit-commercial-2.1",
      "title": "Kenney City Kit (Commercial) 2.1",
      "url": "https://www.kenney.nl/assets/city-kit-commercial",
      "download_url": "https://www.kenney.nl/media/pages/assets/city-kit-commercial/a742d900eb-1753115042/kenney_city-kit-commercial_2.1.zip",
      "license": "CC0-1.0",
      "creator": "Kenney",
      "bundled_selection": [
        "detail-awning-wide.glb",
        "detail-overhang-wide.glb",
        "detail-parasol-a.glb"
      ],
      "reason": "可复用入口雨篷、挑檐和场地遮阳构件，改善盒子化建筑的入口表达。"
    },
    {
      "id": "shapespark-low-poly-plants",
      "title": "Shapespark Low Poly Exterior Plants Kit",
      "url": "https://github.com/shapespark/shapespark-assets",
      "license": "CC0-1.0",
      "creator": "Shapespark",
      "bundled_selection": [],
      "reason": "官方说明为手工制作并针对实时渲染优化；当前先作为可选扩展来源，避免一次打包整套高数量植物。"
    },
    {
      "id": "quaternius-cc0-packs",
      "title": "Quaternius CC0 Asset Packs",
      "url": "https://quaternius.com/",
      "license": "CC0-1.0",
      "creator": "Quaternius",
      "bundled_selection": [],
      "reason": "提供 OBJ、FBX、glTF 等模块化低多边形资源；当前只列为候选，需逐包审核风格与尺寸后再精选。"
    },
    {
      "id": "kaykit-city-builder-bits-1.0",
      "title": "KayKit City Builder Bits 1.0",
      "url": "https://github.com/KayKit-Game-Assets/KayKit-City-Builder-Bits-1.0",
      "license": "CC0-1.0",
      "creator": "KayKit",
      "bundled_selection": [
        "road_straight_crossing.gltf",
        "trafficlight_A.gltf"
      ],
      "reason": "GitHub 项目明确提供 32 个以上面向城市构建的低多边形模型与 glTF/OBJ/FBX 格式；本轮仅精选斑马线道路块和交通灯，保留 CC0 来源并按需加载，避免整包纹理拖大软件。"
    },
    {
      "id": "planning-toolbox-native-components-2026",
      "title": "Planning Toolbox Native Procedural Components 2026",
      "url": "https://creativecommons.org/publicdomain/zero/1.0/",
      "license": "CC0-1.0",
      "creator": "Planning Toolbox",
      "bundled_selection": [
        "parked_car",
        "bench",
        "shrub_cluster",
        "bollard",
        "bus_shelter"
      ],
      "reason": "本项目用 SketchUp Ruby 原生几何生成的可审计组件，补充停车、公共空间和道路界面表达；组件按需共享加载，不引入外部模型包。"
    }
  ],
